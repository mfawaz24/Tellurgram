<?xml version="1.0" encoding="utf-8"?>
<!--
    SHA-256 fingerprints of every signing key accepted by main's BIND
    binding to the plugin. Referenced from AndroidManifest.xml as
    android:knownCerts="@array/mg_known_main_certs".

    The OS-level BIND permission (signature|knownSigner on API 31+)
    accepts a main app signed with any cert listed here. Main's runtime
    self-pin (MgTorClient.verifyPluginSignature) allowlists the same
    fingerprints, so updating this array means updating the pin allowlist
    in MgTorClient too.

    On Android <12 the knownSigner protectionLevel doesn't exist; the OS
    falls back to strict signature match.
-->
<resources>
    <string-array name="mg_known_main_certs" translatable="false">
        <!-- Developer keystore. -->
        <item>1e73de100e2646be671afad2cb4bb471538e062a745ae5adbe6c7d1666fd1ee9</item>
    </string-array>
</resources>
